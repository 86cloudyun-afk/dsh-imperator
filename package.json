{
  "name": "@local/dsh-taskforce",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "任务部队：主会话研究决策、子代理按需执行的多 agent 生产工具（DSH agent preset）",
  "main": "lib/index.js",
  "scripts": {
    "test": "node tools/verify-all.mjs --mode=offline",
    "test:integration": "node tools/verify-all.mjs --mode=integration",
    "test:all": "node tools/verify-all.mjs --mode=all"
  },
  "exports": {
    ".": "./lib/index.js",
    "./store": "./lib/store/index.js",
    "./tools": "./lib/tools/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "docs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
